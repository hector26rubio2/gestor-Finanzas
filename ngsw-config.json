{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css",
          "/icons/icon-192.png",
          "/icons/icon.svg"
        ]
      }
    },
    {
      "name": "chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/chunk-*.js", "/polyfills-*.js"]
      }
    },
    {
      "name": "recursos",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/icons/**", "/vendor/**", "/**/*.(svg|png|jpg|jpeg|webp|woff|woff2)"]
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**"],
  "navigationRequestStrategy": "performance"
}
