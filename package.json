{
  "name": "gestor-finanzas-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "start": "ng serve --port 4300",
    "build": "ng build",
    "iconos:categorias": "node scripts/generar-iconos-categoria.mjs",
    "pwa:iconos": "node scripts/generar-iconos-pwa.mjs",
    "pwa:manifest": "node scripts/validar-manifest.mjs",
    "pwa:servir": "node scripts/servir-dist.mjs",
    "i18n:gen": "node scripts/i18n.mjs",
    "i18n:check": "node scripts/i18n.mjs --check",
    "test": "ng test --watch=false",
    "lint": "eslint src --config eslint.config.cjs",
    "format:check": "prettier --check src",
    "test:ui": "node scripts/visual-test.mjs",
    "test:permisos": "node scripts/permisos-por-seccion.mjs",
    "test:a11y": "node scripts/accesibilidad.mjs",
    "test:atlas": "node --test scripts/atlas/portal.test.mjs",
    "api:tipos": "openapi-typescript openapi/v1.json -o src/app/core/api/generado/esquema.d.ts",
    "diagramas": "node scripts/diagramas.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e-carril": "node --test scripts/e2e-carril.test.mjs",
    "e2e:local": "node scripts/e2e-local.mjs",
    "prepare": "husky",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json"
  },
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/service-worker": "22.2.5",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@spartan-ng/brain": "1.9.0",
    "@tanstack/angular-table": "9.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "driver.js": "1.10.2",
    "echarts": "^6.1.0",
    "modern-screenshot": "^4.7.0",
    "ngx-scrollbar": "^19.1.5",
    "rxjs": "~7.8.2",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@playwright/test": "1.65.0",
    "@spartan-ng/cli": "1.9.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "axe-core": "4.14.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "7.13.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.0",
    "zone.js": "~0.16.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
