{
  "version": 1,
  "projects": {
    "finanzas-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/spartan.css", "src/styles.css"],
            "outputPath": "dist"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                },
                {
                  "type": "anyScript",
                  "maximumWarning": "1MB",
                  "maximumError": "1.5MB"
                }
              ],
              "outputHashing": "all",
              "namedChunks": false,
              "security": {
                "autoCsp": true
              },
              "sourceMap": false,
              "extractLicenses": true,
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": {
                  "inline": true
                }
              }
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "finanzas-web:build:development",
            "host": "127.0.0.1"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest",
            "tsConfig": "tsconfig.spec.json",
            "setupFiles": ["src/test-setup.ts"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
